        return;
      }

      const btn = document.getElementById('btnRedeemSubmit');
      btn.disabled = true;

      try {
        const newBal = curBal - amt;
        await updateDoc(doc(db, 'users', u.mobile), { balance: newBal });

        const reqId = 'WTH-' + Math.floor(1000 + Math.random() * 9000);
        const reqData = {
          id: reqId,
          userMobile: u.mobile,
          userName: u.name,
          type: 'WITHDRAWAL',
