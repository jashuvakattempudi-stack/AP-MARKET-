    // 12-Hour Clock with AM/PM
    function updateClockAndStatuses() {
      const now = new Date();
      let hours = now.getHours();
      const mins = String(now.getMinutes()).padStart(2, '0');
      const secs = String(now.getSeconds()).padStart(2, '0');
      const ampm = hours >= 12 ? 'PM' : 'AM';
      
      const hours12 = hours % 12 || 12;
      const time12Str = `${String(hours12).padStart(2, '0')}:${mins}:${secs} ${ampm}`;

      const clockEl = document.getElementById('liveClock');
      if (clockEl) clockEl.textContent = time12Str;

      const currentTime24 = `${String(hours).padStart(2, '0')}:${mins}`;

      window.userAppState.markets.forEach(m => {
        const isOvernight = m.closeTime < m.openTime;
        let status = 'OPEN_RUNNING';
        if (isOvernight) {
          if (currentTime24 >= m.openTime || currentTime24 < m.closeTime) {
            status = (currentTime24 >= m.openTime) ? 'OPEN_RUNNING' : 'CLOSE_ONLY';
          } else {
            status = 'CLOSED';
          }
        } else {
          if (currentTime24 < m.openTime) {
            status = 'OPEN_RUNNING';
          } else if (currentTime24 >= m.openTime && currentTime24 < m.closeTime) {
            status = 'CLOSE_ONLY';
          } else {
            status = 'CLOSED';
          }
        }
        m.sessionStatus = status;

        const badgeEl = document.getElementById(`badge-${m.id}`);
        const btnEl = document.getElementById(`btnPlay-${m.id}`);
        if (badgeEl && btnEl) {
          if (status === 'OPEN_RUNNING') {
            badgeEl.className = "bg-emerald-500/20 text-emerald-400 text-[9px] font-bold px-2 py-0.5 rounded-full";
            badgeEl.textContent = "OPEN RUNNING";
            btnEl.disabled = false;
            btnEl.className = "py-1 px-2.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow transition";
            btnEl.textContent = "PLAY";
          } else if (status === 'CLOSE_ONLY') {
            badgeEl.className = "bg-amber-500/20 text-amber-400 text-[9px] font-bold px-2 py-0.5 rounded-full";
            badgeEl.textContent = "CLOSE ONLY";
            btnEl.disabled = false;
            btnEl.className = "py-1 px-2.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow transition";
            btnEl.textContent = "PLAY";
          } else {
            badgeEl.className = "bg-red-500/20 text-red-400 text-[9px] font-bold px-2 py-0.5 rounded-full";
            badgeEl.textContent = "CLOSED";
            btnEl.disabled = true;
            btnEl.className = "py-1 px-2.5 rounded-lg bg-slate-800 text-slate-500 font-bold text-xs cursor-not-allowed";
            btnEl.textContent = "CLOSED";
          }
        }
      });
    }

