    const db = getFirestore(app);

    async function initAuth() {
      try {
        await signInAnonymously(auth);
      } catch (e) {
        console.warn("Auth note:", e.message);
      }
    }

    function subscribeRealtimeStreams() {
      onSnapshot(doc(db, 'system_config', 'settings'), (snap) => {
        if (snap.exists()) {
          window.userAppState.settings = Object.assign(window.userAppState.settings, snap.data());
          syncSettingsUI();
          checkApkUpdateAvailability();
        }
      }, () => {});

      onSnapshot(collection(db, 'markets'), (snapshot) => {
        if (!snapshot.empty) {
          snapshot.forEach(docSnap => {
            const data = docSnap.data();
            if (data && data.result) {
              window.updateMarketResultUI(docSnap.id, data.result);
            }
          });
        }
      }, (err) => {
        console.warn("Markets stream:", err.message);
      });

      onSnapshot(doc(db, 'market_board', 'live'), (snap) => {
        if (snap.exists() && snap.data().list) {
          snap.data().list.forEach(m => {
            if (m.result && m.result !== '***-**-***') {
              window.updateMarketResultUI(m.id, m.result);
            }
          });
        }
      }, () => {});
    }

    function checkApkUpdateAvailability() {
      const s = window.userAppState.settings;
      if (s.latestApkVersion && s.latestApkVersion !== CURRENT_CLIENT_VERSION && s.apkDownloadUrl) {
        const modal = document.getElementById('apkUpdateModal');
        const verTag = document.getElementById('apkUpdateVersionTag');
        const dLink = document.getElementById('btnApkDownloadLink');
        const dismissBtn = document.getElementById('btnDismissUpdate');

        if (modal && dLink) {
          verTag.textContent = `New Version: ${s.latestApkVersion}`;
          dLink.href = s.apkDownloadUrl;
          if (s.forceUpdate) {
            dismissBtn.classList.add('hidden');
          } else {
            dismissBtn.classList.remove('hidden');
          }
          modal.classList.remove('hidden');
        }
      }
    }

    function subscribeUserPersonalData(mobile) {
      if (!mobile) return;
      onSnapshot(doc(db, 'users', mobile), (snap) => {
        if (snap.exists()) {
          const fresh = snap.data();
          fresh.balance = (typeof fresh.balance === 'number') ? fresh.balance : 0;
          window.userAppState.currentUser = fresh;
          updateUserUI();
        }
      }, () => {});

      onSnapshot(doc(db, 'activities', mobile), (snap) => {
        if (snap.exists()) {
          const act = snap.data();
          window.userAppState.bids = act.bids || [];
          window.userAppState.winnings = act.winnings || [];
          window.userAppState.statements = act.statements || [];
          renderBids();
          renderWinnings();
          renderStatements();
        }
      }, () => {});
    }

    window.handleUserRegister = async function(e) {
      e.preventDefault();
      const name = document.getElementById('regName').value.trim();
      const username = document.getElementById('regUsername').value.trim();
      const mobile = document.getElementById('regMobile').value.trim();
      const password = document.getElementById('regPassword').value;

      if (mobile.length !== 10 || isNaN(mobile)) {
        showToast('దయచేసి 10 అంకెల మొబైల్ ఇవ్వండి', 'error');
        return;
      }

      const btn = document.getElementById('btnRegisterSubmit');
      btn.disabled = true;
      btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> REGISTERING...`;

      try {
        const uRef = doc(db, 'users', mobile);
        const uSnap = await getDoc(uRef);
        if (uSnap.exists()) {
          showToast('ఈ నంబర్ ఇప్పటికే రిజిస్టర్ అయింది!', 'error');
          return;
        }

        const newUser = {
          name,
          username,
          mobile,
          email: `${mobile}@apmarket.in`,
          password,
          balance: 0,
          bankDetails: { accountNumber: '', bankName: '', ifsc: '', holderName: '' },
          createdAt: new Date().toISOString()
        };

        await setDoc(uRef, newUser);
        await setDoc(doc(db, 'activities', mobile), { bids: [], winnings: [], statements: [] });

        showToast('రిజిస్ట్రేషన్ పూర్తయింది! బ్యాలెన్స్: ₹0. లాగిన్ అవ్వండి.', 'success');
        showScreen('screen-login');
        document.getElementById('loginMobile').value = mobile;
        document.getElementById('loginPassword').value = '';
      } catch (err) {
        showToast('సర్వర్ ఎర్రర్ వచ్చింది. దయచేసి మళ్లీ ప్రయత్నించండి.', 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<span>REGISTER ACCOUNT</span>`;
      }
    };

    window.handleUserLogin = async function(e) {
      e.preventDefault();
      const mobile = document.getElementById('loginMobile').value.trim();
      const password = document.getElementById('loginPassword').value;

      const btn = document.getElementById('btnLoginSubmit');
      btn.disabled = true;

      try {
        const uRef = doc(db, 'users', mobile);
        const snap = await getDoc(uRef);
        if (!snap.exists()) {
          showToast('ఈ నంబర్ రిజిస్టర్ కాలేదు!', 'error');
          return;
        }

        const user = snap.data();
        if (user.password !== password) {
          showToast('పాస్‌వర్డ్ తప్పు!', 'error');
          return;
        }

        user.balance = (typeof user.balance === 'number') ? user.balance : 0;
        window.userAppState.currentUser = user;
        updateUserUI();
        subscribeUserPersonalData(mobile);

        showToast(`స్వాగతం, ${user.name}! (₹${user.balance})`, 'success');
        showScreen('screen-home');
      } catch (err) {
        showToast('లాగిన్ విఫలమైంది', 'error');
      } finally {
        btn.disabled = false;
      }
    };

    window.submitLiveBet = async function() {
      const u = window.userAppState.currentUser;
      if (!u) {
        showToast('ముందుగా లాగిన్ అవ్వండి', 'error');
        return;
      }

      const numVal = document.getElementById('txtBetNumber').value.trim();
      const points = parseInt(document.getElementById('txtBetPoints').value, 10);

      if (!numVal) {
        showToast('నంబర్ ఎంటర్ చేయండి', 'error');
        return;
      }
      if (!points || points < 10) {
        showToast('కనీస బిడ్ ₹10', 'error');
        return;
      }
      const curBal = (typeof u.balance === 'number') ? u.balance : 0;
      if (curBal < points) {
        showToast('వాలెట్‌లో సరిపడా బ్యాలెన్స్ లేదు!', 'error');
        return;
      }

      const btn = document.getElementById('btnSubmitBet');
      btn.disabled = true;

      try {
        const newBal = curBal - points;
        await updateDoc(doc(db, 'users', u.mobile), { balance: newBal });

        const newBid = {
          id: 'BID-' + Math.floor(100000 + Math.random() * 900000),
          marketId: window.userAppState.activeMarketId,
          userMobile: u.mobile,
          userName: u.name,
          gameType: window.userAppState.activeGameType,
          session: window.userAppState.activeGameType === 'JODI_DIGIT' ? 'JODI' : window.userAppState.activeSession,
          number: numVal,
          amount: points,
          time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
          status: 'RUNNING',
          timestamp: Date.now()
        };

        const actRef = doc(db, 'activities', u.mobile);
        const actSnap = await getDoc(actRef);
        let existingBids = actSnap.exists() ? (actSnap.data().bids || []) : [];
        let existingStmts = actSnap.exists() ? (actSnap.data().statements || []) : [];
        let existingWins = actSnap.exists() ? (actSnap.data().winnings || []) : [];

        existingBids.unshift(newBid);
        existingStmts.unshift({
          id: newBid.id,
          type: 'DEBIT',
          amount: points,
          desc: `Bet on ${newBid.marketId} (${newBid.gameType} - ${newBid.number})`,
          time: newBid.time
        });

        await setDoc(actRef, { bids: existingBids, statements: existingStmts, winnings: existingWins });
        await setDoc(doc(db, 'all_bids', newBid.id), newBid);

        closeBetModal();
        showToast(`₹${points} బిడ్ నమోదైంది!`, 'success');
      } catch (err) {
        showToast('బిడ్ సమర్పించడంలో లోపం', 'error');
      } finally {
        btn.disabled = false;
      }
    };

    window.handleDepositRequest = async function(e) {
      e.preventDefault();
      const u = window.userAppState.currentUser;
      if (!u) return;

      const amt = parseInt(document.getElementById('depositAmount').value, 10);
      const utr = document.getElementById('depositUtr').value.trim();

      if (amt < 500) {
        showToast('కనీస డిపాజిట్ ₹500', 'error');
        return;
      }

      const btn = document.getElementById('btnDepositSubmit');
      btn.disabled = true;
      btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> పంపబడుతోంది...`;

      try {
        const reqId = 'DEP-' + Math.floor(1000 + Math.random() * 9000);
        const reqData = {
          id: reqId,
          userMobile: u.mobile,
          userName: u.name,
          type: 'DEPOSIT',
          amount: amt,
          utr: utr,
          proofImage: window.userAppState.selectedProofBase64 || '',
          method: `QR / UPI (${window.userAppState.settings.officialUpi})`,
          status: 'PENDING',
          time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
          timestamp: Date.now()
        };

        await setDoc(doc(db, 'payment_requests', reqId), reqData);

        const actRef = doc(db, 'activities', u.mobile);
        const actSnap = await getDoc(actRef);
        let stmts = actSnap.exists() ? (actSnap.data().statements || []) : [];
        stmts.unshift({
          id: reqId,
          type: 'PENDING',
          amount: amt,
          desc: `Deposit via QR (UTR: ${utr})`,
          time: 'Pending Admin Approval'
        });
        await updateDoc(actRef, { statements: stmts });

        showToast('డిపాజిట్ రిక్వెస్ట్ క్షణాల్లో అడ్మిన్‌కు పంపబడింది!', 'success');
        document.getElementById('depositAmount').value = '';
        document.getElementById('depositUtr').value = '';
        window.userAppState.selectedProofBase64 = null;
        document.getElementById('proofPreviewWrap').classList.add('hidden');
        showScreen('screen-home');
      } catch (err) {
        showToast('డిపాజిట్ విఫలమైంది', 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<i class="fa-solid fa-bolt"></i> SUBMIT DEPOSIT (FAST)`;
      }
    };

    window.handleRedeemRequest = async function(e) {
      e.preventDefault();
      const u = window.userAppState.currentUser;
      if (!u) return;

      const amt = parseInt(document.getElementById('redeemAmount').value, 10);
      const method = document.getElementById('redeemMethod').value.trim();
      const curBal = (typeof u.balance === 'number') ? u.balance : 0;

      if (amt < 1000) {
